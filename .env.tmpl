# Local development defaults (bun run dev:backend / dev:frontend against a
# directly-exposed instance at http://localhost:1111 - no reverse-proxy subpath).
#
# For the production Unraid deployment (fakult.net/journal, behind a reverse proxy
# that strips the "/journal" prefix), the real values live in
# docker-compose.prod.yml instead - NEXTAUTH_URL/NEXT_PUBLIC_BASE_URL there are set
# to the full public https://fakult.net/journal URL, which matters for Pocket-ID SSO
# (see docs/workstreams/01-deploy-pipeline.md). Don't copy this file's localhost
# values into production.
NEXTAUTH_URL=http://localhost:1111
NEXT_PUBLIC_BASE_URL=http://localhost:1111
NEXTAUTH_SECRET=my_ultra_secure_nextauth_secret
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres:5435/postgres

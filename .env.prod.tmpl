# Copy this file to `.env` in the same directory as docker-compose.prod.yml
# on the actual deploy host (Unraid) and fill in real values. `.env` itself is
# gitignored - never commit real secrets.
#
# docker-compose.prod.yml loads this automatically (env_file: .env) and
# references ${NEXTAUTH_SECRET} / ${DATABASE_URL} from it.

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Real credentials for the external Postgres at 192.168.1.203:5432 - the
# username/password below are placeholders, not real values.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_REAL_PASSWORD@192.168.1.203:5432/postgres

# Copy this file to `.env` in the same directory as docker-compose.prod.yml
# on the actual deploy host (Unraid) and fill in real values. `.env` itself is
# gitignored - never commit real secrets.
#
# docker-compose.prod.yml loads this automatically (env_file: .env) and
# references ${NEXTAUTH_SECRET} / ${DATABASE_URL} from it.

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Real credentials for the external Postgres at 192.168.1.203:5432 - the
# username/password below are placeholders, not real values.
DATABASE_URL=postgresql://postgres:REPLACE_WITH_REAL_PASSWORD@192.168.1.203:5432/postgres

# --- AI: Ollama (chat/tagging, embeddings/RAG, vision) ----------------------
# All optional - docker-compose.prod.yml falls back to the values below (the
# current defaults) if left unset here. Swapping a model is just editing the
# value here and restarting the container (`docker compose up -d`) - no image
# rebuild, no code change. See prisma/seed.ts's seedDefaultAiConfig doc
# comment and docs/workstreams/04-ai-pipeline.md for how these get applied.
OLLAMA_BASE_URL=http://192.168.1.208:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=llava
# Optional, separate model for AI Post-Processing (tag suggestion, mood
# scoring, auto-comment/smartEdit/custom, tagAuditJob backfill) -- runs on
# every note automatically, so a smaller/faster model than OLLAMA_CHAT_MODEL
# is often worth it here. Leave unset/commented to just use OLLAMA_CHAT_MODEL
# for post-processing too (also editable anytime in Settings -> AI, no
# restart needed for that path).
# OLLAMA_POST_PROCESSING_MODEL=llama3.1

# --- AI: Whisper (voice transcription) --------------------------------------
# Leave WHISPER_BASE_URL commented/unset until docker-compose.whisper.yml is
# actually deployed alongside docker-compose.prod.yml - seed.ts skips voice
# setup entirely while it's unset, and setting it before the whisper
# container exists would wire voiceModelId to an address nothing is
# listening on yet. Once deployed, uncomment (container-to-container address,
# matches docker-compose.network.yml's blinko-internal network):
# WHISPER_BASE_URL=http://whisper:8000/v1
# Must match PRELOAD_MODELS in docker-compose.whisper.yml (that file reads
# this same var) - change it in one place.
WHISPER_MODEL=Systran/faster-whisper-medium
